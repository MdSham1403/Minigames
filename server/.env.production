# ── Server production .env ────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying

PORT=5000

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# PostgreSQL — use Supabase connection string (Session mode, port 5432)
DB_HOST=db.YOURPROJECT.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_SUPABASE_PASSWORD


# Set to your Vercel deployment URL after deploying frontend
CLIENT_URL=https://your-app-name.vercel.app
